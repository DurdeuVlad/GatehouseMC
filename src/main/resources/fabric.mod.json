{
  "schemaVersion": 1,
  "id": "gatehousemc",
  "version": "${version}",
  "name": "GatehouseMC",
  "description": "Server-side whitelist gatehouse for offline-mode Minecraft servers.",
  "authors": ["GatehouseMC contributors"],
  "contact": {
    "issues": "https://github.com/GatehouseMC/GatehouseMC/issues"
  },
  "license": "MIT",
  "icon": "assets/gatehousemc/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.gatehousemc.platform.fabric.GatehouseMod"
    ]
  },
  "mixins": [
    "gatehousemc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  }
}
